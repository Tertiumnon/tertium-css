{
  "name": "@tertium/css",
  "version": "1.5.0",
  "description": "Universal design system with tokens, themes, components, and utilities",
  "main": "dist/bundles/full.min.css",
  "type": "module",
  "scripts": {
    "build": "bun run theme:generate:all && bun scripts/build/build.ts",
    "theme:generate": "bun scripts/theme/generate/generate.ts",
    "theme:generate:all": "bun theme:generate dark.blue--white && bun theme:generate dark.purple--gold && bun theme:generate dark.violet--gold && bun theme:generate light.white--red",
    "lint": "prettier --check 'src/{bundles,components,form,system,utilities}/**/*.css'",
    "lint:css:fix": "prettier --write 'src/{bundles,components,form,system,utilities}/**/*.css'",
    "test": "bun test",
    "hooks:install": "bun node_modules/@tertium/js/scripts/git-hooks/git-hooks.ts",
    "workflow:publish": "bun node_modules/@tertium/js/scripts/npm-publish-workflow/npm-publish-workflow.ts",
    "release:patch": "bun node_modules/@tertium/js/scripts/release/release.ts patch",
    "release:minor": "bun node_modules/@tertium/js/scripts/release/release.ts minor",
    "release:major": "bun node_modules/@tertium/js/scripts/release/release.ts major",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "css",
    "design-system",
    "tokens",
    "themes",
    "components",
    "utilities",
    "tailwind",
    "bootstrap",
    "universal"
  ],
  "exports": {
